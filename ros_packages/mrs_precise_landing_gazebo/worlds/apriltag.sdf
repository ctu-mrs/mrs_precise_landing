<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="default">

    <!-- physics {-->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8066</gravity>
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <!--}-->

    <!-- scene {-->
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <!--}-->

    <!-- coordinate system {-->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397743</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <!--}-->

    <!-- ground plane {-->
    <include>
      <uri>model://mrs_gazebo_common_resources/models/grass_plane</uri>
      <name>grass_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!--}-->

    <!-- sun {-->
    <light name="sun" type="directional">
      <pose>0 0 1000 0.4 0.2 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.1 0.1 -0.9</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0.01</linear>
        <constant>0.5</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <!--}-->

    <!-- landing pad model {-->
    <include>
      <uri>model://Apriltag_recursive1</uri>
      <pose>1.0 1.0 0.001 0 0 1.2</pose>
    </include>
    <!--}-->

    <!-- initial camera pose {-->
    <gui>
      <camera name="user_camera">
        <pose>8 -8 6 0 0.5 2.356</pose>
      </camera>
    </gui>
    <!--}-->

  </world>
</sdf>
